__pycache__/
*.pyc
.claude/
.DS_Store
screenshots/
/HANDOVER.md

# Real per-deployment data — hostnames, MACs, home-dir paths, driver fingerprints. Never
# committed to a public repo. See hosts/example.yaml, models.example.yaml and manifest.example.yaml
# for the templates that ARE tracked; copy them and fill in your own machine's facts locally.
/hosts/*.yaml
!/hosts/example.yaml
/hosts/*.lock.yaml
/hosts/*.hidden-units.yaml
/hosts/*.update-cache.yaml
/models.yaml
/scripts.yaml
/manifest.yaml
!/manifest.example.yaml

