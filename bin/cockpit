#!/usr/bin/env python3
import argparse
import os
import sys
from pathlib import Path

_REPO_ROOT = Path(__file__).resolve().parent.parent
_VENV_DIR = _REPO_ROOT / ".venv"


def _venv_python() -> Path | None:
    bin_dir = _VENV_DIR / "bin"
    if not bin_dir.is_dir():
        return None
    for name in ("python3", "python"):  # not every venv creates these symlinks
        candidate = bin_dir / name
        if candidate.exists():
            return candidate
    # Fall back to whatever version-specific interpreter is actually in there
    # (e.g. python3.14) — some venv builds skip the generic python3/python symlinks.
    matches = sorted(bin_dir.glob("python3.*"))
    return matches[0] if matches else None


_venv = _venv_python()
if _venv is not None and Path(sys.executable).resolve() != _venv.resolve():
    # Re-exec under the repo's own venv (see requirements.txt / README Setup) so `bin/cockpit`
    # works regardless of which `python3` happened to be first on PATH when it was invoked.
    os.execv(str(_venv), [str(_venv), str(Path(__file__).resolve()), *sys.argv[1:]])
elif _venv is None and _VENV_DIR.is_dir():
    # A .venv directory exists but no usable interpreter was found in it — say so explicitly
    # instead of silently falling through to system Python and a confusing ModuleNotFoundError.
    sys.exit(
        f"{_VENV_DIR} exists but no python executable was found under {_VENV_DIR / 'bin'} "
        "(checked python3, python, python3.*). List that directory and check the venv wasn't "
        "left partially created."
    )

sys.path.insert(0, str(_REPO_ROOT))

try:
    from cockpit.app import CockpitApp  # noqa: E402
except ImportError as e:
    sys.exit(
        f"missing dependency ({e}). Set up the tool's venv first:\n"
        f"  python3 -m venv {_VENV_DIR}\n"
        f"  {_VENV_DIR}/bin/pip install -r {_REPO_ROOT}/requirements.txt\n"
        "then re-run this script."
    )


def main() -> None:
    parser = argparse.ArgumentParser(prog="cockpit")
    parser.add_argument("--host", default=None, help="host profile to use (defaults to this machine's hostname)")
    args = parser.parse_args()
    CockpitApp(host=args.host).run()


if __name__ == "__main__":
    main()
