#!/usr/bin/env python3
import argparse
import os
import sys
from pathlib import Path

_REPO_ROOT = Path(__file__).resolve().parent.parent
_VENV_DIR = _REPO_ROOT / ".venv"


def _venv_python() -> Path | None:
    for name in ("python3", "python"):  # not every venv creates a `python3` symlink
        candidate = _VENV_DIR / "bin" / name
        if candidate.exists():
            return candidate
    return None


_venv = _venv_python()
if _venv is not None and Path(sys.executable).resolve() != _venv.resolve():
    # Re-exec under the repo's own venv (see requirements.txt / README Setup) so `bin/cockpit`
    # works regardless of which `python3` happened to be first on PATH when it was invoked.
    os.execv(str(_venv), [str(_venv), str(Path(__file__).resolve()), *sys.argv[1:]])

sys.path.insert(0, str(_REPO_ROOT))

try:
    from cockpit.app import CockpitApp  # noqa: E402
except ImportError as e:
    sys.exit(
        f"missing dependency ({e}). Set up the tool's venv first:\n"
        f"  python3 -m venv {_VENV_DIR}\n"
        f"  {_VENV_DIR}/bin/pip install -r {_REPO_ROOT}/requirements.txt\n"
        "then re-run this script."
    )


def main() -> None:
    parser = argparse.ArgumentParser(prog="cockpit")
    parser.add_argument("--host", default=None, help="host profile to use (defaults to this machine's hostname)")
    args = parser.parse_args()
    CockpitApp(host=args.host).run()


if __name__ == "__main__":
    main()
