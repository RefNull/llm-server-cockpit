#!/usr/bin/env python3
import argparse
import os
import sys
from pathlib import Path

_REPO_ROOT = Path(__file__).resolve().parent.parent
_VENV_DIR = _REPO_ROOT / ".venv"


def _add_venv_site_packages() -> None:
    """Add .venv's site-packages to sys.path directly rather than re-exec'ing into
    .venv/bin/python3 — that file can be a plain symlink to the system python3 (confirmed on
    a real deployment target), in which case re-exec launches the exact same interpreter
    binary and Python's own venv auto-detection doesn't reliably kick in (Debian's Python
    packaging patches this machinery). Adding the path directly needs none of that: it's the
    one thing a venv actually provides, and this interpreter can use it regardless of whether
    it was invoked through .venv/bin/python3 or system python3."""
    lib_dir = _VENV_DIR / "lib"
    if not lib_dir.is_dir():
        return
    for py_dir in sorted(lib_dir.glob("python3.*"), reverse=True):
        site_packages = py_dir / "site-packages"
        if site_packages.is_dir():
            sys.path.insert(0, str(site_packages))
            return


_add_venv_site_packages()
sys.path.insert(0, str(_REPO_ROOT))

try:
    from cockpit.app import CockpitApp  # noqa: E402
except ImportError as e:
    sys.exit(
        f"missing dependency ({e}). Set up the tool's venv first:\n"
        f"  python3 -m venv {_VENV_DIR}\n"
        f"  {_VENV_DIR}/bin/pip install -r {_REPO_ROOT}/requirements.txt\n"
        "then re-run this script."
    )


def main() -> None:
    parser = argparse.ArgumentParser(prog="cockpit")
    parser.add_argument("--host", default=None, help="host profile to use (defaults to this machine's hostname)")
    parser.add_argument(
        "--sudo",
        action="store_true",
        help="re-exec the whole cockpit under sudo, instead of elevating per action",
    )
    args = parser.parse_args()

    if args.sudo and os.geteuid() != 0:
        # Re-exec rather than elevate per action. The per-action gate
        # (CockpitScreenBase.confirm(requires_root=True)) stays the default because it keeps
        # unprivileged work unprivileged — an HF download running as root leaves root-owned
        # files in models_dir. --sudo is for a session that is going to be mostly privileged
        # work and does not want a prompt each time.
        # The euid guard is what stops an exec loop: after sudo, euid is 0 and this is skipped
        # even though --sudo is still in argv.
        os.execvp("sudo", ["sudo", "-E", sys.executable, str(Path(__file__).resolve()), *sys.argv[1:]])

    CockpitApp(host=args.host).run()


if __name__ == "__main__":
    main()
